---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Privacy — PurrSafe" description="How PurrSafe handles information submitted through the private beta waitlist.">
  <main class="legal-page wrap">
    <a class="skip" href="#content">Skip to content</a>
    <a class="brand legal-page__brand" href="/">PurrSafe</a>
    <article id="content">
      <h1>Privacy</h1>
      <p>Private beta registration collects your email address so we can contact you about access. We do not sell it or use it for unrelated marketing.</p>
      <p>We retain registration data only as long as needed to operate the beta and handle access requests. Contact us to ask about access, correction, or deletion.</p>
      <p><a href="mailto:hello@pursafe.selenasolutions.com">hello@pursafe.selenasolutions.com</a></p>
    </article>
  </main>
</Layout>
