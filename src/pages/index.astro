---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
const asset = (path: string) => `${import.meta.env.BASE_URL}assets/${path}`;
---

<Layout>
<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="#top">
      <img class="brand__mark" src={asset('purrsafe-mark@2x.png')} width="144" height="144" alt="">
      PurrSafe
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">Menu</button>
    <nav class="nav" id="primary-nav" aria-label="Primary">
      <a href="#how">How it works</a>
      <a href="#proof">In the app</a>
      <a href="#trust">Safety</a>
      <a href="#faq">FAQ</a>
      <a class="btn btn--primary btn--sm" href="#get">Get the app</a>
    </nav>
  </div>
</header>

<main id="main">

  <!-- ================= HERO ================= -->
  <section class="hero" id="top">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <span class="badge">Private beta</span>
        <h1>Know what is safe. Remember what matters.</h1>
        <p class="lead">
          PurrSafe is a private memory and care log for your cat. Note what happened,
          let it be organised for you, and find the answer again the moment you need it —
          at the vet, at dinner time, or when someone else is feeding her.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#get">Get the app</a>
          <a class="btn btn--ghost" href="#how">See how it works</a>
        </div>
        <div class="hero__note">
          <span class="hero__note-bar" aria-hidden="true"></span>
          <p class="meta">
            PurrSafe is in private beta. <strong>Get the app</strong> joins the waitlist
            today and becomes a direct App&nbsp;Store link at launch.
          </p>
        </div>
      </div>

      <div class="hero__stage">
        <div class="device device--front">
          <img src={asset('app-memory-feed@2x.png')} width="880" height="1912"
               alt="PurrSafe memory feed on iPhone, showing four dated entries for the cat Mochi: a play note, a sneezing note being monitored, a 4.2 kg weight check, and a tuna pâté breakfast.">
        </div>
        <div class="device device--back" aria-hidden="true">
          <img src={asset('app-ask-ai@2x.png')} width="880" height="1912" alt="">
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PROBLEM ================= -->
  <section class="band--surface">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">The problem</span>
        <h2>Your cat&rsquo;s history lives in six different places</h2>
        <p class="lead">
          Photos in the camera roll, weights in a notes app, the vet&rsquo;s advice in a
          half-remembered conversation. When it matters, none of it is where you look.
        </p>
      </div>
      <div class="problem__grid">
        <div class="problem__item"><p>&ldquo;When did she last lose weight?&rdquo;</p></div>
        <div class="problem__item"><p>&ldquo;Can she actually eat this?&rdquo;</p></div>
        <div class="problem__item"><p>&ldquo;What do I tell the cat sitter?&rdquo;</p></div>
      </div>
    </div>
  </section>

  <!-- ================= BENEFITS ================= -->
  <section>
    <div class="wrap">
      <div class="section-head section-head--center">
        <span class="eyebrow">What you get</span>
        <h2>One calm place for everything about her</h2>
      </div>
      <div class="cards cards--4">
        <article class="clay card">
          <div class="card__icon" aria-hidden="true">🍽️</div>
          <h3>Food you can check</h3>
          <p>Log meals and check what she is eating before it becomes a worry.</p>
        </article>
        <article class="clay card">
          <div class="card__icon" aria-hidden="true">✨</div>
          <h3>Memories that log themselves</h3>
          <p>Write it the way you&rsquo;d say it. PurrSafe tags and files it by type and date.</p>
        </article>
        <article class="clay card">
          <div class="card__icon" aria-hidden="true">🔍</div>
          <h3>Ask, don&rsquo;t scroll</h3>
          <p>Ask a question about your cat and get an answer drawn only from her own log.</p>
        </article>
        <article class="clay card">
          <div class="card__icon" aria-hidden="true">🐈</div>
          <h3>A profile per pet</h3>
          <p>Every pet in the household keeps a separate archive, so nothing gets mixed up.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ================= HOW IT WORKS ================= -->
  <section id="how" class="band--deep">
    <div class="wrap">
      <div class="section-head section-head--center">
        <span class="eyebrow">How it works</span>
        <h2>Capture &rarr; Understand &rarr; Remember</h2>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step__num" aria-hidden="true">1</span>
          <h3>Capture</h3>
          <p>Pick the pet, pick the type, add a line or a photo. It takes seconds.</p>
          <div class="step__shot">
            <img src={asset('app-add-event@2x.png')} width="880" height="1912"
                 alt="The PurrSafe add-memory sheet: a pet selector with Mochi chosen, memory type chips for Food, Health, Weight, Play and Note with Weight selected, a title field, and a body-weight input in kilograms.">
          </div>
        </div>
        <div class="step">
          <span class="step__num" aria-hidden="true">2</span>
          <h3>Understand</h3>
          <p>Each entry is typed and tagged, so the log stays structured without extra work.</p>
          <div class="step__shot">
            <img src={asset('app-memory-feed@2x.png')} width="880" height="1912"
                 alt="The PurrSafe memory feed filtered by pet and by category chips for Food, Health, Vet and Behavior.">
          </div>
        </div>
        <div class="step">
          <span class="step__num" aria-hidden="true">3</span>
          <h3>Remember</h3>
          <p>Ask a question later. The assistant answers from that cat&rsquo;s memories only.</p>
          <div class="step__shot">
            <img src={asset('app-ask-ai@2x.png')} width="880" height="1912"
                 alt="The PurrSafe Ask AI screen, headed “Whose story today?”, listing Mochi with a resumable session and LUNU with a start button.">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PRODUCT PROOF ================= -->
  <section id="proof" class="band--surface">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">In the app</span>
        <h2>This is the real thing</h2>
        <p class="lead">
          Every screen on this page is an unretouched capture from the PurrSafe build —
          no mockups, no invented reviews.
        </p>
      </div>

      <div class="proof__grid">
        <div class="proof__stage">
          <div class="device">
            <img src={asset('app-ask-ai@2x.png')} width="880" height="1912"
                 alt="PurrSafe Ask AI screen showing a resumable session for Mochi, a British Shorthair, with the last question “What did Mochi eat recently?” from 28 minutes ago.">
          </div>
        </div>

        <div>
          <div class="callouts">
            <div class="callout">
              <span class="callout__dot" aria-hidden="true">1</span>
              <div>
                <h3>One cat at a time</h3>
                <p>The assistant is scoped to a single pet&rsquo;s memories, so answers never bleed across profiles.</p>
              </div>
            </div>
            <div class="callout">
              <span class="callout__dot" aria-hidden="true">2</span>
              <div>
                <h3>Sessions pick up where you left off</h3>
                <p>Your last question stays visible and resumable instead of disappearing into a chat history.</p>
              </div>
            </div>
            <div class="callout">
              <span class="callout__dot" aria-hidden="true">3</span>
              <div>
                <h3>Grounded in your own log</h3>
                <p>Answers cite the memories you recorded &mdash; not generic advice from the internet.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TRUST & SAFETY ================= -->
  <section id="trust" class="band--teal">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Trust &amp; safety</span>
        <h2>Her life, not our dataset</h2>
      </div>
      <div class="trust__grid">
        <article class="trust__item">
          <h3>Private by default</h3>
          <p>Your log belongs to your account. It is not public, not shared, and not sold.</p>
        </article>
        <article class="trust__item">
          <h3>Honest about the AI</h3>
          <p>The assistant reads what you wrote. It can still be wrong, and it tells you what it used.</p>
        </article>
        <article class="trust__item">
          <h3>You can leave</h3>
          <p>Export or delete your pet&rsquo;s archive whenever you want.</p>
        </article>
      </div>
      <p class="disclaimer">
        <strong>Not veterinary advice.</strong> PurrSafe helps you record and recall what you
        have observed. It does not diagnose, treat, or replace a veterinarian. If you are
        worried about your cat, contact your vet.
      </p>
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section id="faq">
    <div class="wrap">
      <div class="section-head section-head--center">
        <span class="eyebrow">FAQ</span>
        <h2>Questions people actually ask</h2>
      </div>
      <div class="faq">
        <details open>
          <summary>What does PurrSafe actually do?</summary>
          <p>It gives your cat a single private log — meals, weights, health notes, behaviour, vet visits — and lets you ask questions against it later instead of scrolling.</p>
        </details>
        <details>
          <summary>Is it available yet?</summary>
          <p>PurrSafe is in private beta. Join the waitlist and we&rsquo;ll send your invite; when the store listing is live this page links straight to it.</p>
        </details>
        <details>
          <summary>Who can see my cat&rsquo;s memories?</summary>
          <p>You. Entries are tied to your account and are not published or shared with other users.</p>
        </details>
        <details>
          <summary>Can it tell me if a food is dangerous?</summary>
          <p>It can help you record and look up what your cat ate and flag what you have logged before. It is not a medical authority — anything urgent goes to your vet.</p>
        </details>
        <details>
          <summary>Does it work for more than one pet?</summary>
          <p>Yes. Each pet gets its own profile and its own archive, and the assistant only reads the one you select.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ================= FINAL CTA ================= -->
  <section id="get" class="band--surface">
    <div class="wrap">
      <div class="cta-panel">
        <span class="eyebrow">Private beta</span>
        <h2>Start her archive today</h2>
        <p class="lead" style="margin-inline:auto">
          Leave your email and we&rsquo;ll send an invite as soon as a slot opens.
        </p>
        <form class="waitlist" action={`${import.meta.env.BASE_URL}api/beta-register`} method="post" data-waitlist-form novalidate>
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" inputmode="email"
                 autocomplete="email" required placeholder="you@example.com" aria-describedby="waitlist-msg">
          <input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="waitlist__honeypot">
          <button class="btn btn--primary" type="submit">Get the app</button>
          <p class="waitlist__msg waitlist__status" id="waitlist-msg" data-waitlist-status role="status" aria-live="polite" tabindex="-1"></p>
        </form>
        <p class="meta">We use your email only to send a private-beta invite. No spam.</p>
      </div>
    </div>
  </section>

</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer__grid">
      <a class="brand" href="#top">
        <img class="brand__mark" src={asset('purrsafe-mark@2x.png')} width="144" height="144" alt="">
        PurrSafe
      </a>
      <nav class="footer__links" aria-label="Footer">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/contact">Contact</a>
        <a href="#faq">FAQ</a>
      </nav>
    </div>
    <p class="footer__legal">
      © 2026 PurrSafe. Private beta. PurrSafe is a record-keeping tool and does not
      provide veterinary advice. App screenshots are unmodified captures of the current build.
    </p>
  </div>
</footer>

<script>
  const form = document.querySelector('[data-waitlist-form]');
  const status = document.querySelector('[data-waitlist-status]');
  const email = document.querySelector('#email');
  const navToggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('#primary-nav');

  navToggle?.addEventListener('click', () => {
    if (!(navToggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
    const expanded = navToggle.getAttribute('aria-expanded') === 'true';
    navToggle.setAttribute('aria-expanded', String(!expanded));
    nav.classList.toggle('nav--open', !expanded);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

    if (email instanceof HTMLInputElement && !email.validity.valid) {
      email.setAttribute('aria-invalid', 'true');
      status.setAttribute('role', 'alert');
      status.className = 'waitlist__msg waitlist__status waitlist__msg--error';
      status.textContent = 'Enter a valid email address.';
      email.focus();
      return;
    }

    const button = form.querySelector('button');
    if (button instanceof HTMLButtonElement) {
      button.disabled = true;
      button.dataset.pending = 'true';
      button.setAttribute('aria-busy', 'true');
    }
    if (email instanceof HTMLInputElement) email.removeAttribute('aria-invalid');
    status.className = 'waitlist__msg waitlist__status';
    status.textContent = 'Joining the waitlist…';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await response.json() as { message?: string };
      status.textContent = result.message ?? (response.ok ? 'You are on the waitlist.' : 'Registration is temporarily unavailable.');
      status.classList.add(response.ok ? 'waitlist__msg--success' : 'waitlist__msg--error');
      status.setAttribute('role', response.ok ? 'status' : 'alert');
      status.focus();
    } catch {
      status.textContent = 'Registration is temporarily unavailable. Try again later.';
      status.classList.add('waitlist__msg--error');
      status.setAttribute('role', 'alert');
      status.focus();
    } finally {
      if (button instanceof HTMLButtonElement) {
        button.disabled = false;
        delete button.dataset.pending;
        button.removeAttribute('aria-busy');
      }
    }
  });
</script>
</Layout>
